{
  "$schema": "https://opencode.ai/config.json",

  // ── Models ────────────────────────────────────────────────────────
  // Free-tier only. Paid model IDs return HTTP 402 on the Kilo gateway.
  // Swap for an explicit `:free` model from `opencode models kilo` if 402 appears.
  "model": "{{MODEL}}",
  "small_model": "{{SMALL_MODEL}}",

  "shell": "pwsh.exe",
  "update": "notify",

  // ── Agent selection ────────────────────────────────────────────────
  // Only the two built-in primary agents (build, plan) are meant to appear in
  // the Tab / Shift+Tab cycle. Every agent generated below is mode:"subagent",
  // so the model picks the right one automatically from its description and you
  // can still @-mention any of them by hand.
  "default_agent": "build",

  // ── Worktrees ─────────────────────────────────────────────────────
  // Fleet agents work in isolated worktrees under this path.
  "worktree": {
    "directory": ".lane/trees"
  },

  // ── Permissions ───────────────────────────────────────────────────
  // Appended after the V2 base policy (allow *, external_directory ask, .env ask).
  // Last match wins, so specific exceptions go after broad rules.
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "git push origin *", "effect": "ask" },
    { "action": "read", "resource": "*.env", "effect": "deny" }
  ],

  // ── MCP servers ───────────────────────────────────────────────────
  // Generated by install.ps1. Add your own with:
  //   opencode mcp add <name> --global --url <url>
  //   opencode mcp add <name> --global -- <cmd> <args...>
  "mcp": {
    "servers": {
      // __MCP_BLOCK__
    }
  },

  // ── Agents ────────────────────────────────────────────────────────
  // Generated by install.ps1 from agents/<domain>/*.yaml.
  // Never hand-edit this block; edit the YAML sources instead and re-run install.
  "agents": {
    // __AGENTS_BLOCK__
  }
}
